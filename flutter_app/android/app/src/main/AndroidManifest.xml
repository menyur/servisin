<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- WAJIB untuk akses jaringan (Supabase REST/Realtime, gambar avatar,
         upload bukti bayar). Tanpa izin ini APK release gagal lookup host
         ("Failed host lookup: 'xxx.supabase.co'") walau WiFi/data aktif —
         build debug/profile mendapat izin dari manifest debug, tapi
         manifest utama TIDAK mewariskannya ke build release. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Ambil foto langsung dengan kamera di wizard booking (lampiran),
         bukti pembayaran, laporan, foto profil, dan KTP saat pendaftaran.
         image_picker yang meminta izin runtime ini saat kamera dipakai;
         tanpa deklarasi di sini, panggilan kamera bisa SecurityException. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- GPS on-duty teknisi: kirim posisi saat layar Pekerjaan aktif supaya
         jarak ke job terbuka tampil dan admin bisa cari teknisi terdekat.
         geolocator meminta izin runtime saat dipakai; tanpa deklarasi di
         sini, getCurrentPosition gagal di build release. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- WAJIB untuk url_launcher di Android 11+ (API 30+, package visibility):
         tombol rute teknisi membuka Google Maps via URL https. Tanpa blok
         <queries> ini, canLaunchUrl mengembalikan false di device baru dan
         tombol rute gagal diam-diam. Sumber: README package url_launcher. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
    <application
        android:label="Fixify"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
