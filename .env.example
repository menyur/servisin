[TEMPLATE]
# --- Supabase (wajib) ---
# Ambil dari Project Settings > API di dashboard Supabase kamu
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-key-kamu

# --- Email notifikasi (opsional) ---
# Kalau kosong, email hanya disimulasikan (dicetak ke log server), aplikasi tetap jalan normal.
RESEND_API_KEY=
EMAIL_FROM="Servisin <onboarding@resend.dev>"

# --- Payment gateway Midtrans (opsional) ---
# Kalau kosong, pembayaran otomatis pakai mode simulasi, aplikasi tetap bisa dicoba end-to-end.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Produksi (Vercel / domain sendiri) ---
# URL publik situs — dipakai sitemap, robots, OG image, dan link di email.
NEXT_PUBLIC_SITE_URL=https://servisin.vercel.app

# Service role key — HANYA untuk server (cron arsip laporan bulanan).
# Ambil dari Supabase > Settings > API > service_role. JANGAN pernah di-commit.
SUPABASE_SERVICE_ROLE_KEY=

# Secret untuk endpoint cron /api/cron/monthly-report (header x-cron-secret).
# Buat string acak, misal: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=
